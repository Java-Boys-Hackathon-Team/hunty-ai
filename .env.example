# Скопируй в .env рядом с docker-compose.yml и подставь значения.
# Любой ключ можно оставить заглушкой: сервисы поднимутся, не работать будут
# только обращения к соответствующему внешнему API.

OPENAI_API_KEY=<ключ OpenAI>
MAIL_KEY=<пароль приложения для SMTP>
TELEGRAM_BOT_TOKEN=<токен Telegram-бота>
